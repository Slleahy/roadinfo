{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Slleahy/roadinfo/schema/card.schema.json",
  "title": "roadinfo card",
  "type": "object",
  "required": [
    "id",
    "level",
    "anchor",
    "title",
    "text",
    "sentences",
    "sources",
    "topics",
    "scores",
    "sensitive",
    "asOf",
    "themeKeys"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "level": {
      "enum": [
        "sight",
        "stretch",
        "town",
        "person",
        "county",
        "landscape",
        "region"
      ],
      "description": "What the card is about. 'person' is a biography card: somebody born or raised at this place. It is anchored like a town card and plays where the person is from."
    },
    "anchor": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "point",
            "segment",
            "place",
            "county",
            "unit",
            "state",
            "region"
          ]
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "reachMeters": {
          "type": "number",
          "description": "How far from the road this still matters (points)."
        },
        "path": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[lon, lat] pairs (segments)."
        },
        "placeGeoid": {
          "type": "string",
          "description": "Census place GEOID (places)."
        },
        "fips": {
          "type": "string",
          "description": "County FIPS (counties) or state FIPS (states)."
        },
        "unitId": {
          "type": "string",
          "description": "Landscape unit id, e.g. ecoregion or watershed code."
        },
        "name": {
          "type": "string"
        },
        "bothDirections": {
          "type": "boolean",
          "description": "Segments: true if the card fits travel in either direction along the path; otherwise it fits travel in path order only."
        },
        "stretchId": {
          "type": "string"
        }
      }
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "sentences": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "text",
          "sources"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "url",
          "retrieved",
          "quote"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "table": {
            "type": "string",
            "description": "Dataset and year for numeric facts."
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "relevance",
        "interest",
        "confidence"
      ],
      "properties": {
        "relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "interest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "confidence": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        }
      }
    },
    "sensitive": {
      "type": "array",
      "items": {
        "enum": [
          "crime",
          "voting",
          "demographics",
          "tragedy"
        ]
      }
    },
    "asOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "themeKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pronunciations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "followOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direction": {
      "type": [
        "string",
        "null"
      ],
      "description": "Segments: plain-language direction the card is written for, e.g. 'Ridgecrest to Inyokern'; null if both."
    },
    "checked": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "removed": {
          "type": "integer"
        }
      }
    },
    "near": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "radiusMeters",
        "source"
      ],
      "description": "Where a card belongs when it is about one spot: the app plays it only within radiusMeters of this point.",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "radiusMeters": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "URL of the page the coordinates come from."
        }
      }
    },
    "elsewhere": {
      "type": "object",
      "required": [
        "name",
        "lat",
        "lon",
        "source"
      ],
      "description": "A place the card mentions that is away from where the card plays. A distant fact is only ever an extension of a local subject: the card must open with what is true here, and the distant part must say how far away it is. Write that distance as the placeholder {distance} (and optionally {direction}) in the sentence; the app fills it from the car's position when it speaks, so it is right wherever the listener happens to be. Never write a distance as a fixed number, because it goes stale the moment the car moves.",
      "properties": {
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "description": "URL of the page the coordinates come from."
        }
      }
    }
  }
}
